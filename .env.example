# ==============================================================================
# DOCKER COMPOSE / DEPLOYMENT ENVIRONMENT EXAMPLE
# Copy this file to '.env' in the repository root before running docker compose:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# DEPLOYMENT MODE
# ------------------------------------------------------------------------------
# `true` = force local Ollama
# `false` = allow Groq to be primary when GROQ_API_KEY is set
USE_OLLAMA=true
OLLAMA_HOST=http://ollama:11434

# ------------------------------------------------------------------------------
# OLLAMA MODEL PREFERENCES
# ------------------------------------------------------------------------------
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_STRUCTURED_MODEL=llama3:8b
OLLAMA_LIGHTWEIGHT_MODEL=phi3.5:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ------------------------------------------------------------------------------
# OLLAMA MODEL STORAGE
# ------------------------------------------------------------------------------
# Local default for development. On GCP, the startup script writes:
# OLLAMA_MODEL_MOUNT_PATH=/mnt/ollama-models
OLLAMA_MODEL_MOUNT_PATH=ollama_data

# ------------------------------------------------------------------------------
# APP URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# BACKEND CORS
# ------------------------------------------------------------------------------
# Comma-separated origins allowed by the FastAPI backend.
# For GCP VM demos, set this to the public frontend URL, e.g.:
# CORS_ORIGINS=http://35.200.136.14:3000,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# APP SECRETS / DATABASE
# ------------------------------------------------------------------------------
SECRET_KEY=super-secret-key-change-in-production
GROQ_API_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aireadiness
POSTGRES_HOST=db
POSTGRES_PORT=5432
