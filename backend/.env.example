# ==============================================================================
# AI READINESS INTELLIGENCE STUDIO - ENV CONFIGURATION EXAMPLE
# Copy this file to '.env' inside the backend folder to override settings:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# APP GENERAL CONFIG
# ------------------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=super-secret-key-change-in-production

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Switch to 'true' if you want to enforce PostgreSQL instead of SQLite
# Docker Compose defaults REQUIRE_POSTGRES=true. Local unit tests may use false (SQLite).
REQUIRE_POSTGRES=false

# SQLite URL (used by default when Postgres is not required)
SQLITE_URL=sqlite:///./aireadiness.db

# PostgreSQL Configurations (when active)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aireadiness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional raw connection string override (e.g. for production RDS or external DB)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ------------------------------------------------------------------------------
# CLOUD LLM SETTINGS (OPENAI)
# ------------------------------------------------------------------------------
# Enter your OpenAI API Key to enable GPT cloud reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# CLOUD LLM SETTINGS (GROQ) — optional legacy
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# EXECUTION SAFETY
# ------------------------------------------------------------------------------
# DEMO_MODE=true returns clearly marked simulated outputs when models are unavailable.
# Real assessments fail closed unless a verified provider succeeds.
DEMO_MODE=false
ALLOW_HEURISTIC_FALLBACK=false
ALLOW_EXTERNAL_MODEL_PROVIDERS=true
ALLOW_OLLAMA_FALLBACK=true
ENABLE_DEMO_AUTH=true
ENABLE_DEMO_WORKSPACE=true

# ------------------------------------------------------------------------------
# LOCAL LLM SETTINGS (OLLAMA fallback / offline mode)
# ------------------------------------------------------------------------------
# Set to 'true' if you want to bypass cloud LLM and route exclusively to local Ollama.
# Set to 'false' to let OpenAI become the primary path when OPENAI_API_KEY is set.
USE_OLLAMA=false

# Connection endpoint for local Ollama service.
# Local backend run: http://localhost:11434
# Docker Compose backend run: http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# Comma-separated frontend origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Ollama Model Catalog mappings
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_STRUCTURED_MODEL=llama3:8b
OLLAMA_LIGHTWEIGHT_MODEL=phi3.5:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
